@{
    ViewBag.Title = "Giới thiệu - Reciper";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-3">
    <!-- Phần giới thiệu đầu trang -->
    <div class="p-4 mb-4 bg-light border rounded">
        <h3 class="fw-bold mb-2">Website Quản Lý & Chia Sẻ Công Thức Nấu Ăn</h3>
        <p class="text-secondary mb-0">
            Reciper là hệ thống hỗ trợ lưu trữ, phân loại và chia sẻ các công thức nấu ăn gia đình. Website giúp người dùng dễ dàng tìm kiếm nguyên liệu, các bước nấu và thời gian thực hiện cho từng món ăn.
        </p>
    </div>

    <!-- 3 mục nội dung chính -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&auto=format&fit=crop&q=80" class="card-img-top" style="height: 180px; object-fit: cover;" alt="Món ăn">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Tra cứu món ăn</h5>
                    <p class="card-text text-secondary small">
                        Hỗ trợ tra cứu nhanh các món mặn, món canh, món xào hoặc đồ uống với định lượng nguyên liệu cụ thể.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border">
                <img src="https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=500&auto=format&fit=crop&q=80" class="card-img-top" style="height: 180px; object-fit: cover;" alt="Nguyên liệu">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Chia sẻ công thức</h5>
                    <p class="card-text text-secondary small">
                        Người dùng có thể tự đăng tải món ăn của mình, chia sẻ kinh nghiệm chế biến và hình ảnh từng bước làm.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border">
                <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=500&auto=format&fit=crop&q=80" class="card-img-top" style="height: 180px; object-fit: cover;" alt="Quản trị">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Quản trị hệ thống</h5>
                    <p class="card-text text-secondary small">
                        Trang quản trị cho phép thêm sửa xóa công thức, quản lý danh mục và danh sách người dùng trong hệ thống.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>