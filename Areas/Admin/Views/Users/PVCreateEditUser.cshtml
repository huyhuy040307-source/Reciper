@model Reciper.Models.user
<style>
    .user-grid-table {
        width: 100%;
        table-layout: fixed;
    }
    .user-grid-table td {
        width: 33.33%;
        padding: 14px;
        vertical-align: top;
        background-color: #f8f9fa;
    }
    .user-grid-table .field-label {
        display: block;
        font-weight: 600;
        color: #198754;
        margin-bottom: 6px;
    }
    .user-grid-table .form-control {
        width: 100%;
        max-width: 100%;
    }
</style>

<table class="table table-bordered user-grid-table">
    <tr>
        <td>
            <label class="field-label">Tên đăng nhập</label>
            @Html.EditorFor(model => model.username, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            @Html.ValidationMessageFor(model => model.username, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Họ tên</label>
            @Html.EditorFor(model => model.full_name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            @Html.ValidationMessageFor(model => model.full_name, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Email</label>
            @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control", type = "email", required = "required" } })
            @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <td>
            <label class="field-label">Mật khẩu</label>
            @Html.EditorFor(model => model.password_hash, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            @Html.ValidationMessageFor(model => model.password_hash, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Vai trò</label>
            @Html.DropDownList("role", (SelectList)ViewBag.RoleList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.role, "", new { @class = "text-danger" })
        </td>
        <td>
            <label class="field-label">Kích hoạt tài khoản</label>
            <div class="form-check form-switch pt-2">
                @Html.CheckBoxFor(model => model.is_active, new { @class = "form-check-input", @id = "isActiveCheck" })
                <label class="form-check-label" for="isActiveCheck">Được phép đăng nhập</label>
            </div>
            @Html.ValidationMessageFor(model => model.is_active, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <td colspan="3" class="text-center py-3">
            <input type="submit" value="Lưu tài khoản" class="btn btn-primary px-4" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </td>
    </tr>
</table>
