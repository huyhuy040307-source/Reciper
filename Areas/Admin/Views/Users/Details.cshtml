@model Reciper.Models.user

@{
    ViewBag.Title = "Chi tiết tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2">THÔNG TIN CHI TIẾT TÀI KHOẢN</h2>

<table class="table table-bordered mt-3" style="max-width: 700px;">
    <tr>
        <th class="bg-light" style="width: 30%;">ID</th>
        <td>@Model.id</td>
    </tr>
    <tr>
        <th class="bg-light">Tên đăng nhập</th>
        <td class="fw-bold">@Html.DisplayFor(model => model.username)</td>
    </tr>
    <tr>
        <th class="bg-light">Họ tên</th>
        <td>@Html.DisplayFor(model => model.full_name)</td>
    </tr>
    <tr>
        <th class="bg-light">Email</th>
        <td>@Html.DisplayFor(model => model.email)</td>
    </tr>
    <tr>
        <th class="bg-light">Vai trò</th>
        <td>
            @if (string.Equals(Model.role, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge bg-danger">Admin</span>
            }
            else
            {
                <span class="badge bg-info text-dark">User</span>
            }
        </td>
    </tr>
    <tr>
        <th class="bg-light">Trạng thái</th>
        <td>
            @if (Model.is_active)
            {
                <span class="badge bg-success">Đang hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary">Bị khóa</span>
            }
        </td>
    </tr>
    <tr>
        <th class="bg-light">Ngày tạo</th>
        <td>@Model.created_at.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>
</table>

<p class="mt-3">
    @Html.ActionLink("Cập nhật", "Edit", new { id = Model.id }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
</p>
