@model Reciper.Models.user

@{
    ViewBag.Title = "Xóa tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-danger text-white p-2">XÓA TÀI KHOẢN</h2>

<div class="alert alert-warning mt-3">
    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa tài khoản <strong>@Model.username</strong> (@Model.full_name) không? Hành động này không thể hoàn tác!
</div>

<table class="table table-bordered" style="max-width: 600px;">
    <tr>
        <th class="bg-light" style="width: 35%;">Tên đăng nhập</th>
        <td>@Model.username</td>
    </tr>
    <tr>
        <th class="bg-light">Họ tên</th>
        <td>@Model.full_name</td>
    </tr>
    <tr>
        <th class="bg-light">Email</th>
        <td>@Model.email</td>
    </tr>
    <tr>
        <th class="bg-light">Vai trò</th>
        <td>@Model.role</td>
    </tr>
</table>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        @Html.ActionLink("Hủy bỏ, quay lại", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}
