@model Reciper.Models.ViewModel.RecipeSearchVM

<head>
    <style>
        img {
            height: 150px;
            max-width: 150px;
            object-fit: cover;
        }
        .table{
            border:2px;
        }
    </style>
</head>

<h2 class="#">DANH SÁCH CÔNG THỨC MÓN ĂN</h2>

<table class="">
    <tr>
        <th class="bg-danger col-md-2"> Hình ảnh </th>
        <th class="bg-danger col-md-3"> Tên món ăn </th>
        <th class="bg-danger col-md-1"> TG nấu (phút) </th>
        <th class="bg-danger col-md-1"> Độ khó </th>
        <th class="bg-danger col-md-2"> Danh mục </th>
        <th class="bg-danger col-md-3"></th>
    </tr>

    @if (Model.Recipes != null)
    {
        foreach (var item in Model.Recipes)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.image_url))
                    {
                        <img src="@item.image_url" alt="@item.title" onerror="this.outerHTML='<span class=&quot;text-muted&quot;>Không có ảnh</span>'" />
                    }
                    else
                    {
                        <span class="text-muted">Không có ảnh</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.cook_minutes)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.difficulty)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.category.name)
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.id }, new { @class = "btn btn-primary btn-sm" }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.id }, new { @class = "btn btn-primary btn-sm" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.id }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    }
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    @Html.ActionLink(i.ToString(), "Index", new
                    {
                        page = i,
                        searchTerm = Model.SearchTerm,
                        minCookMinutes = Model.MinCookMinutes,
                        maxCookMinutes = Model.MaxCookMinutes,
                        sortOrder = Model.SortOrder
                    }, new { @class = "page-link" })
                </li>
            }
        </ul>
    </nav>
}

<div class="form-group">
    <div class="col-md-offset-3 col-md-9">
        @Html.ActionLink("Thêm mới", "Create", null,
       new { @class = "btn btn-primary" })
    </div>
</div>

