
@model Reciper.Models.ViewModel.RecipeSearchVM

<style>
    .recipe-list img {
        height: 150px;
        max-width: 150px;
        width: 100%;
        object-fit: cover;
        border-radius: 5px;
    }

    .recipe-list {
        width: 100%;
        border-collapse: collapse;
    }

        .recipe-list th,
        .recipe-list td {
            vertical-align: middle;
            padding: 8px;
        }
</style>

<h2>DANH SÁCH CÔNG THỨC MÓN ĂN</h2>

<table class="table table-bordered table-striped recipe-list">
    <thead>
        <tr>
            <th class="bg-danger">Hình ảnh</th>
            <th class="bg-danger">Tên món ăn</th>
            <th class="bg-danger">TG nấu (phút)</th>
            <th class="bg-danger">Độ khó</th>
            <th class="bg-danger">Danh mục</th>
            <th class="bg-danger">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Recipes != null && Model.Recipes.Any())
        {
            foreach (var item in Model.Recipes)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.image_url))
                        {
                            <img src="@item.image_url"
                                 alt="@item.title"
                                 onerror="this.outerHTML='<span class=&quot;text-muted&quot;>Không có ảnh</span>'" />
                        }
                        else
                        {
                            <span class="text-muted">Không có ảnh</span>
                        }
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.title)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.cook_minutes)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.difficulty)
                    </td>

                    <td>
                        @(item.category != null ? item.category.name : "Chưa phân loại")
                    </td>

                    <td>
                        @Html.ActionLink("Sửa", "Edit",
                                 new { id = item.id },
                                 new { @class = "btn btn-primary btn-sm" })

                        @Html.ActionLink("Chi tiết", "Details",
                                 new { id = item.id },
                                 new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Xóa", "Delete",
                                 new { id = item.id },
                                 new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-danger">
                    Chưa có công thức nào được tìm thấy!
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                    @Html.ActionLink(i.ToString(), "Index", new
                    {
                        page = i,
                        searchTerm = Model.SearchTerm,
                        minCookMinutes = Model.MinCookMinutes,
                        maxCookMinutes = Model.MaxCookMinutes,
                        sortOrder = Model.SortOrder
                    },
                         new { @class = "page-link" })

                </li>
            }

        </ul>
    </nav>
}

<div class="form-group">
    <div class="col-md-offset-3 col-md-9">

        @Html.ActionLink("Thêm mới", "Create", null,
                 new { @class = "btn btn-primary" })

    </div>
</div>
