
@model Reciper.Models.recipe

@{
    ViewBag.Title = "Thêm công thức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THÊM CÔNG THỨC</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@using (Html.BeginForm("Create", "Recipes", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-2" })

        @Html.Partial("PVCreateEditRecipe", Model)
    </div>
}

@section Scripts {
    <script src="@Url.Content("~/Scripts/MyJS/CreateEdit.js")"></script>
    @Scripts.Render("~/bundles/jqueryval")
}
