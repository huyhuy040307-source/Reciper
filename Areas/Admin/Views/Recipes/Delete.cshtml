@model Reciper.Models.recipe

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA CÔNG THỨC</h2>

<h3 class="alert-danger">Bạn có chắc muốn xóa công thức này không?</h3>

@Html.Partial("PVRecipeInfo", Model)
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-primary" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>
}

