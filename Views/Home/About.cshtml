@{
    ViewBag.Title = "Giới thiệu";
}

<div class="container py-4">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold text-success mb-3">Về Dự Án Reciper</h2>
