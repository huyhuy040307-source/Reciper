@model Reciper.Models.user

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-3">
    <h3 class="fw-bold mb-3">ĐĂNG KÝ TÀI KHOẢN</h3>
    <hr />

    @using (Html.BeginForm("Register", "Account", new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }

            <div class="form-group row mb-3">
                <label class="control-label col-md-2 fw-semibold">Tên đăng nhập</label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.username, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.username, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="control-label col-md-2 fw-semibold">Họ tên</label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.full_name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.full_name, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="control-label col-md-2 fw-semibold">Email</label>
                <div class="col-md-6">
                    @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control", type = "email", required = "required" } })
                    @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group row mb-3">
                <label class="control-label col-md-2 fw-semibold">Mật khẩu</label>
                <div class="col-md-6">
                    @Html.PasswordFor(model => model.password_hash, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(model => model.password_hash, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-group row mt-4">
                <div class="col-md-offset-2 col-md-6">
                    <input type="submit" value="Đăng ký" class="btn btn-primary" />
                    @Html.ActionLink("Quay lại đăng nhập", "Login", "Account", new { area = "Admin" }, new { @class = "btn btn-outline-secondary ms-2" })
                </div>
            </div>
        </div>
    }
</div>